# ClimaSense — copie para .env e preencha. NUNCA versione o .env.
# Ambiente: desenvolvimento | demonstracao | producao
AMBIENTE=desenvolvimento

# MongoDB Atlas (bronze + território) — mesma variável do ETL e do mapa anteriores
MONGO_URI=
MONGO_DB_TERRITORIO=Recife
MONGO_DB_BRONZE_VACINACAO=vacinacao

# Postgres / Neon (silver + gold + aplicação). NEON_URL também é aceito como sinônimo.
# Ex.: postgresql://USUARIO:SENHA@SEU-HOST.neon.tech/climasense?sslmode=require
DATABASE_URL=

# Sessão. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSAO_INATIVIDADE_MIN=60
CORS_ORIGINS=http://localhost:5173

# Primeiro administrador (usado só por: python -m climasense.admin criar-admin)
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=

# ETL
ETL_LIMITE_VACINACAO=5000
SUPRESSAO_MINIMA=5

# Mapa
MAP_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}

# Conectores futuros (deixe em branco até implementar)
ANA_USUARIO=
ANA_SENHA=
