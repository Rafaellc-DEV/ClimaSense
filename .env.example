# ClimaSense — copie para .env NA RAIZ do repositório e preencha os campos vazios.
# NUNCA versione o .env nem inclua credenciais reais neste exemplo.
# Ambiente: desenvolvimento | teste | producao
AMBIENTE=desenvolvimento
# EXCLUSIVO de desenvolvimento e demonstração acadêmica, com administrador.
# Modelo 0.2.0 NÃO validado para uso operacional. Nunca habilitar em produção.
# A flag não gera o artefato: veja o comando alagamento-previa-local no README.
ML_PREVIA_EXPERIMENTAL_LOCAL=true

# MongoDB Atlas (bronze + território). Preencha com a URI fornecida pelo responsável.
# Formato ilustrativo: mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
# O usuário precisa acessar o banco bronze e o banco territorial abaixo.
MONGO_URI=
MONGO_DB_TERRITORIO=Recife

# Postgres / Neon (silver + gold + aplicação). Preencha com uma URL válida.
# NEON_URL também é aceito como sinônimo; prefira definir apenas DATABASE_URL.
# Ex.: postgresql://USUARIO:SENHA@SEU-HOST.neon.tech/climasense?sslmode=require
# Em produção, DATABASE_URL é do papel climasense_app (sem poder de dono).
DATABASE_URL=
# OPCIONAL: Alembic, ETL e comandos administrativos usam a URL do dono abaixo.
# AUSENTE/COMENTADA = usa DATABASE_URL, se ela tiver as permissões necessárias.
# Nunca descomente com valor vazio: DATABASE_URL_MIGRACOES= causa erro de URL no SQLAlchemy.
# Só descomente depois de substituir toda a URL ilustrativa por uma válida e autorizada.
# DATABASE_URL_MIGRACOES=postgresql://USUARIO:SENHA@SEU-HOST.neon.tech/climasense?sslmode=require
# criar-papel-app altera a senha do papel e reescreve o .env; não é uma verificação.
# Separação de papéis e autorização para bancos compartilhados: README e ADR 0014.

# Autenticação. setup.ps1 gera SESSION_SECRET se criar o .env; se já existir, gere
# na raiz: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSAO_INATIVIDADE_MIN=60
# Origens separadas por vírgula. Use localhost tanto no navegador quanto nesta lista.
CORS_ORIGINS=http://localhost:5173
# IPs/CIDRs separados por vírgula; vazio = não confiar em proxies reversos.
PROXIES_CONFIAVEIS=

# Primeiro administrador: python -m climasense.admin criar-admin (dentro de backend).
# O comando GRAVA no Postgres. Use e-mail válido e senha com pelo menos 10 caracteres,
# sem conter o e-mail ou o nome do usuário. Troca obrigatória no primeiro acesso.
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=

# Funcionalidades opcionais fora do escopo padrão (ADR 0011), desligadas por padrão.
# Para frontend e backend concordarem, configure também as VITE_FUNC_* correspondentes
# em frontend/.env.local (veja o bloco ao final e o README).
FUNC_LANDING_PUBLICA=false
FUNC_COMUNICADOS=false
FUNC_AVALIACOES=false
FUNC_MAPA_PORTATIL=false
FUNC_ESTATISTICAS_SERIES=false

# Supressão de contagens agregadas pequenas nas respostas de saúde.
SUPRESSAO_MINIMA=5

# Prazo de guarda (ADR 0015): python -m climasense.admin limpar-retencao
RETENCAO_TENTATIVAS_LOGIN_DIAS=90
RETENCAO_SESSOES_DIAS=30

# Mapa
MAP_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}

# Conectores futuros (deixe em branco até implementar)
ANA_USUARIO=
ANA_SENHA=

# Artefato ML opcional: lido de os.environ, NÃO do .env por Configuracao.
# Para trocar o padrão tmp/modelos/risco-alagamento-v0.2.0.joblib, exporte no
# PowerShell ANTES de iniciar o backend/treino; prefira caminho absoluto:
# $env:CLIMASENSE_MODELO_ALAGAMENTO = 'C:\caminho\ClimaSense\tmp\modelos\risco-alagamento-v0.2.0.joblib'

# Testes de integração opcionais: exporte no processo, NÃO neste .env.
# DATABASE_URL_TESTE: apenas Postgres DESCARTÁVEL; as fixtures apagam/recriam esquemas.
# TESTES_COMO_APP=1: executa os testes com o papel climasense_app (ADR 0014).

# FRONTEND: os exemplos abaixo devem ser definidos em frontend/.env.local,
# não neste .env da raiz. Copie frontend/.env.example antes de configurar.
# VITE_ML_DEMO_ACADEMICA=true  # abre a prévia automaticamente; só desenvolvimento
# VITE_FUNC_LANDING_PUBLICA=0
# VITE_FUNC_COMUNICADOS=0
# VITE_FUNC_AVALIACOES=0
# VITE_FUNC_MAPA_PORTATIL=0
# VITE_FUNC_ESTATISTICAS_SERIES=0
# VITE_AMBIENTE=demonstracao  # só exibe a faixa de demonstração; não habilita ML
# VITE_VITRINE=1             # opcional; a vitrine já está ativa no Vite dev
