# ClimaSense — copie para .env e preencha. NUNCA versione o .env.
# Ambiente: desenvolvimento | teste | producao
AMBIENTE=desenvolvimento

# MongoDB Atlas (bronze + território) — mesma variável do ETL e do mapa anteriores
MONGO_URI=
MONGO_DB_TERRITORIO=Recife

# Postgres / Neon (silver + gold + aplicação). NEON_URL também é aceito como sinônimo.
# Ex.: postgresql://USUARIO:SENHA@SEU-HOST.neon.tech/climasense?sslmode=require
# Em produção, DATABASE_URL é do papel `climasense_app` (sem poder de dono); a do dono vai em DATABASE_URL_MIGRACOES.
# `python -m climasense.admin criar-papel-app` gera a senha do papel e grava as duas no .env (ADR 0014).
DATABASE_URL=
# URL do dono do banco: usada só pelo Alembic, pelo ETL e por comandos administrativos. Vazia = usa DATABASE_URL.
DATABASE_URL_MIGRACOES=

# Sessão. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSAO_INATIVIDADE_MIN=60
CORS_ORIGINS=http://localhost:5173

# Primeiro administrador (usado só por: python -m climasense.admin criar-admin)
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=

# ETL
SUPRESSAO_MINIMA=5

# Mapa
MAP_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}

# Conectores futuros (deixe em branco até implementar)
ANA_USUARIO=
ANA_SENHA=
